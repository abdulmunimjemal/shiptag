{
  "name": "shipcard",
  "version": "0.1.0",
  "description": "Generate a beautiful, shareable SVG card for any repository.",
  "keywords": [
    "svg",
    "card",
    "social-preview",
    "og-image",
    "github",
    "readme",
    "cli"
  ],
  "type": "module",
  "bin": {
    "shipcard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "author": "Abdulmunim Jemal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulmunimjemal/shipcard.git"
  },
  "homepage": "https://oss.munim.io/shipcard/",
  "bugs": {
    "url": "https://github.com/abdulmunimjemal/shipcard/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
